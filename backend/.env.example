NODE_ENV=development
PORT=3001
FRONTEND_URL=https://protese-flow.vercel.app
JWT_SECRET=dev-only-change-this-jwt-secret

# Em desenvolvimento, os dados usam o SQLite local.
# Para Supabase, preencha SUPABASE_URL e SUPABASE_SERVICE_KEY.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Evolution API local iniciada pelo docker compose.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=dev-evolution-key-change-me
# Opcional: segredo exclusivo do webhook. Se omitido, usa EVOLUTION_API_KEY.
EVOLUTION_WEBHOOK_SECRET=change-this-webhook-secret
EVOLUTION_INSTANCE=clinica-protese

CLINICA_NOME=Clínica de Prótese Dentária
CLINICA_ENDERECO=Configure o endereço da clínica
CLINICA_HORARIO=Seg a Sex 08h-18h
